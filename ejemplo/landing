"isChild\":false,\"gradient\":null,\"align\":null,\"showFull\":false,\"cssClass\":null}}]\n"])</script><script>self.__next_f.push([1,"2e:[\"$\",\"$L3a\",null,{\"keyTabs\":\"\",\"slug\":\"section-botonera\",\"display\":\"module\",\"direction\":\"horizontal\",\"buttons\":[{\"type\":\"link\",\"text\":\"FOLLETO\",\"href\":\"https://mkg.uai.cl/postgrados-nuevo/diplomados/diplomado-en-growth-hacking-marketing/page/brochure/7750\",\"target\":\"_blank\",\"icon\":\"ri-file-pdf-2-line\",\"style\":{\"theme\":null,\"size\":\"medium\",\"weight\":\"normal\",\"variant\":\"primary\",\"format\":\"button\",\"effect\":\"showicon\"},\"datalayer\":null},{\"type\":\"link\",\"text\":\"AGENDAR REUNIÓN\",\"href\":\"https://calendly.com/uai-myriamosorio/30min/?utm_term=7750\u0026a2=Diplomado en Growth Hacking y Marketing\",\"target\":\"_blank\",\"icon\":\"ri-calendar-line\",\"style\":{\"theme\":null,\"size\":\"medium\",\"weight\":\"normal\",\"variant\":\"primary\",\"format\":\"button\",\"effect\":\"showicon\"},\"datalayer\":null}],\"style\":{\"schema\":null,\"theme\":null,\"overlay\":null,\"overlap\":null,\"isChild\":false,\"gradient\":null,\"align\":null,\"showFull\":false,\"cssClass\":null}}]\n3c:T464,El Diplomado en Growth Hacking \u0026 Marketing (DGHM) \u003cstrong\u003ese especializa en el área del Growth\u003c/strong\u003e. Por ello, el programa además de ver temas de tácticas digitales también hace énfasis en temas más relacionados a la estrategia de un negocio, tales como Lean Startup y Product-Market Fit.  Por su parte, el Diplomado de Marketing Digital \u0026 E-Commerce (DMDE) busca formar profesionales con un \u003cstrong\u003eperfil generalista en estas disciplinas\u003c/strong\u003e. Por lo mismo, el programa aborda una variedad de temas que son comunes en áreas digitales, tales como Marketing Estratégico, Social Media, Paid Media, Comercio Electrónico, entre otros.  Hay temas comunes en ambos programas, tales como SEO, SEM, Paid Media, analítica digital, e inteligencia artificial. Sin embargo, estos temas se ven con focos distintos en ambos diplomas.  Además cada programa tiene sus puntos específicos, por ejemplo el DMDE incluye un módulo completo de E-Commerce, clases de Marketing Estratégico y Redes Sociales. Por su parte, en el DGHM los módulos de Fundamentos y Técnicas Avanzadas de Growth son exclusivos de este programa."])</script><script>self.__next_f.push([1,"3d:T69e,El Growth Marketing es un enfoque del marketing que está basado en datos y que busca crear un crecimiento acelerado y sostenible en las organizaciones.   La disciplina del Growth nace muy enfocada en start-ups del rubro tecnológico, que han recibido o buscan levantar grandes rondas de inversión, y que por lo mismo están en búsquedas de crecer en grandes magnitudes, en poco tiempo, y muchas veces en base a consumir ese capital, con la expectativa de ser rentable en el mediano plazo.  Muchas empresas que no eran de este rubro o que no tenían capital de inversión empezaron a replicar técnicas y estrategias desde estos referentes y eso ha llevado a los modelos de Growth a ser cada vez más populares fuera del tipo de empresas donde se originó, llegando así a industrias más tradicionales.  El Growth se basa en datos, necesita una experimentación rápida, y tiene un foco en todo el viaje del consumidor a través de la empresa, integrando así múltiples canales de marketing y también el desarrollo del producto. Esto contrasta con la perspectiva más tradicional y general del marketing, el cual se enfoca en la adquisición de usuarios y actividades top-of-funnel, tiene un foco más claro en la creatividad, y muchas veces actúa en silos respecto a otras áreas como ventas, o producto.  El Growth Marketing es muchas veces mal entendido como la “evolución del marketing”, pero no es así. El marketing tradicional sigue siendo efectivo en un gran número de empresas e industrias. Sin embargo, el Growth Marketing cada vez suma más adeptos por su impacto y aplicabilidad en industrias donde la tecnología tiene una gran influencia, las cuales son cada vez más."])</script><script type="text/javascript" id="" charset="">!function(b,e,f,g,a,c,d){b.fbq||(a=b.fbq=function(){a.callMethod?a.callMethod.apply(a,arguments):a.queue.push(arguments)},b._fbq||(b._fbq=a),a.push=a,a.loaded=!0,a.version="2.0",a.queue=[],c=e.createElement(f),c.async=!0,c.src=g,d=e.getElementsByTagName(f)[0],d.parentNode.insertBefore(c,d))}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");fbq("init","442586239921989");fbq("track","PageView");</script><script type="text/javascript" id="" charset="">!function(b,e,f,g,a,c,d){b.fbq||(a=b.fbq=function(){a.callMethod?a.callMethod.apply(a,arguments):a.queue.push(arguments)},b._fbq||(b._fbq=a),a.push=a,a.loaded=!0,a.version="2.0",a.queue=[],c=e.createElement(f),c.async=!0,c.src=g,d=e.getElementsByTagName(f)[0],d.parentNode.insertBefore(c,d))}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");fbq("init","876820316021301");fbq("track","PageView");</script><script type="text/javascript" id="" charset="">piAId="857373";piCId="9464";piHostname="pi.pardot.com";(function(){function b(){var a=document.createElement("script");a.type="text/javascript";a.src=("https:"==document.location.protocol?"https://pi":"http://cdn")+".pardot.com/pd.js";var c=document.getElementsByTagName("script")[0];c.parentNode.insertBefore(a,c)}window.attachEvent?window.attachEvent("onload",b):window.addEventListener("load",b,!1)})();</script><script type="text/javascript" id="" charset="">!function(b,e,f,g,a,c,d){b.fbq||(a=b.fbq=function(){a.callMethod?a.callMethod.apply(a,arguments):a.queue.push(arguments)},b._fbq||(b._fbq=a),a.push=a,a.loaded=!0,a.version="2.0",a.queue=[],c=e.createElement(f),c.async=!0,c.src=g,d=e.getElementsByTagName(f)[0],d.parentNode.insertBefore(c,d))}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");fbq("init","781354699304887");fbq("track","PageView");</script><script type="text/ja